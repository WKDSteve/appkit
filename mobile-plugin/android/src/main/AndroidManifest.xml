<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notices of the hub (a red main), asked for when the person turns them on (Android 13 and later, AND-01). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- The messages of the UnifiedPush distributor: not exported beyond the connector's own intent filter, which
             only a distributor the person chose is answered on. -->
        <service
            android:name="io.github.wkdsteve.appkit.PushReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
