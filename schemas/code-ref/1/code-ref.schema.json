{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WKDSteve/appkit/schemas/code-ref/1/code-ref.schema.json",
  "title": "code-ref/1",
  "description": "A pointer to code: repository, file, lines, optionally the commit, an excerpt, the DocMap node and the telemetry key. Shared by tasks, DocMap and the agent. The reader treats it as untrusted input; README.md holds the rules this schema cannot state (64 KiB before parsing, excerpt in UTF-8 bytes, the path rules, no control characters). A reader ignores unknown fields and refuses a higher schema.",
  "type": "object",
  "required": ["schema", "repo", "file", "lines"],
  "properties": {
    "schema": { "const": "code-ref/1" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "sha": { "type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "dirty": { "type": "boolean" },
    "file": { "type": "string", "minLength": 1, "maxLength": 300 },
    "lines": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1, "maximum": 10000000 },
        { "type": "integer", "minimum": 1, "maximum": 10000000 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "lang": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+#._-]{0,31}$" },
    "symbol": { "type": "string", "minLength": 1, "maxLength": 200 },
    "excerpt": { "type": "string", "maxLength": 4096 },
    "truncated": { "type": "boolean" },
    "docmap": {
      "type": "object",
      "required": ["node"],
      "properties": {
        "node": { "type": "string", "minLength": 1, "maxLength": 300 },
        "fn": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "telemetry": {
      "type": "object",
      "required": ["namespace", "key"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1, "maxLength": 100 },
        "key": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "class": { "enum": ["public", "internal"] }
  }
}
